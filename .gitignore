# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# 虚拟环境
.venv/
venv/
env/

# 打包输出
build/
dist/
*.spec

# IDE
.idea/
.vscode/
*.swp

# 运行时数据
data/*.json

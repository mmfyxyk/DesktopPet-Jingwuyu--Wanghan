# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# 虚拟环境
.venv/
venv/
env/

# 打包输出（PyInstaller 自动生成，不入库）
build/
dist/
release/
*.spec
# 例外：手工维护的打包脚本入库
!scripts/
!scripts/*.spec

# IDE
.idea/
.vscode/
*.swp

# 运行时数据
data/*.json
data/*.txt      # douyin_cookies.txt 等用户登录态 Netscape 格式
data/consent.json   # 用户首次启动同意记录（每个用户本地状态，不入库）
!data/.gitkeep
output/*
!output/.gitkeep

# 外部工具（体积大，单独下载，不纳入版本控制）
support/*
!support/README.md

# 大体积媒体文件（测试素材，不纳入版本控制；动画帧应为 PNG）
*.gif
*.mp3
*.mp4
*.wav
*.avi
*.mov
*.mkv

# 日志
*.log

# 系统文件
.DS_Store
Thumbs.db

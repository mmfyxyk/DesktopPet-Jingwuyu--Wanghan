# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# 虚拟环境
.venv/
venv/
env/

# 打包输出（PyInstaller 自动生成，不入库）
build/
dist/
release/
*.spec
# 例外：手工维护的打包脚本入库
!scripts/
!scripts/*.spec

# IDE
.idea/
.vscode/
*.swp

# 运行时数据
data/*.json
data/*.txt      # douyin_cookies.txt 等用户登录态 Netscape 格式
data/consent.json   # 用户首次启动同意记录（每个用户本地状态，不入库）
!data/.gitkeep
output/*
!output/.gitkeep

# 外部工具（体积大，单独下载，不纳入版本控制）
support/*
!support/README.md

# 大体积媒体文件（测试素材，不纳入版本控制；动画帧应为 PNG）
*.gif
*.mp3
*.mp4
*.wav
*.avi
*.mov
*.mkv

# 日志
*.log

# 系统文件
.DS_Store
Thumbs.db

# —— 本地私有资源提取工具链（assets-collect/）：永远不公开 ——
# 整个 output/ 下的导出物（游戏原始资源，法律敏感，体积大）
assets-collect/output/
assets-collect/bundles-local/
assets-collect/inventory.json
assets-collect/.tmp/
# 小脚本本身可以入库（README / requirements / 两个 .py 已经在 assets-collect/.gitignore 里说明）
# 若未来要把整个 assets-collect/ 也排除掉（连脚本都不进公开仓库），再把下行取消注释：
# assets-collect/

